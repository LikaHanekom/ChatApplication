<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/retro_bg"
    tools:context=".activities.HomeActivity">

    <TextView
        android:id="@+id/welcome_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to ChatApp!"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/retro_navy"
        android:fontFamily="monospace"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_conversations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Conversations"
        android:fontFamily="monospace"
        android:backgroundTint="@color/retro_teal"
        android:textColor="@color/retro_cream"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_camera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Camera"
        android:fontFamily="monospace"
        android:backgroundTint="@color/retro_navy"
        android:textColor="@color/retro_cream" />

</LinearLayout>